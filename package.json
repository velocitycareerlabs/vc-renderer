{
  "name": "@velocitycareerlabs/vc-renderer",
  "version": "0.5.0-build",
  "private": true,
  "description": "Verifiable credentials renderer",
  "repository": "https://github.com/velocitycareerlabs/packages",
  "license": "Apache-2.0",
  "main": "dist/index.cjs.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.es.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "require": "./dist/index.cjs.js",
      "import": "./dist/index.es.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepublish": "tsc --declaration",
    "build": "rollup -c",
    "test": "jest",
    "test:ci": "jest --config ./jest.config.js --runInBand --coverage",
    "publish-test": "pnpm run prepublish && pnpm run build && pnpm pack",
    "postinstall": "if test \"$NODE_ENV\" != \"production\" ; then case \"$PWD\" in */node_modules/*) ;; *) pnpm build ;; esac ; fi"
  },
  "dependencies": {
    "date-fns": "^4.0.0",
    "jsonpath-plus": "^10.2.0",
    "lodash-es": "^4.18.1"
  },
  "peerDependencies": {
    "@emotion/react": "^11.13.3",
    "@mui/icons-material": "^6.0.0",
    "@mui/material": "^6.0.0",
    "@react-pdf/renderer": "^4.1.5",
    "i18next": "^23.16.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^14.1.3",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@react-pdf/primitives": "4.1.1",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-image": "2.1.1",
    "@svgr/rollup": "8.1.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@testing-library/react-hooks": "8.0.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "babel-jest": "30.4.1",
    "camelcase": "9.0.0",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "lodash": "^4.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rollup": "4.62.4",
    "rollup-plugin-dts": "6.5.1",
    "rollup-plugin-peer-deps-external": "2.2.4",
    "rollup-plugin-postcss": "4.0.2",
    "rollup-plugin-typescript2": "0.37.0",
    "ts-jest": "29.4.12",
    "typescript": "^5.9.3"
  }
}
