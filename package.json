{
  "name": "@velocitycareerlabs/vc-renderer",
  "version": "0.5.0-build",
  "private": true,
  "description": "Verifiable credentials renderer",
  "repository": "https://github.com/velocitycareerlabs/packages",
  "license": "Apache-2.0",
  "main": "dist/index.cjs.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.es.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "require": "./dist/index.cjs.js",
      "import": "./dist/index.es.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "prepublish": "tsc --declaration",
    "build": "rollup -c",
    "test": "jest",
    "test:ci": "jest --config ./jest.config.js --runInBand --coverage",
    "publish-test": "npm run prepublish && npm run build && npm pack",
    "postinstall": "if test \"$NODE_ENV\" != \"production\" ; then yarn build ; fi"
  },
  "dependencies": {
    "canonicalize": "~2.1.0",
    "date-fns": "~3.6.0",
    "jsonpath-plus": "^10.2.0",
    "lodash-es": "~4.18.0"
  },
  "peerDependencies": {
    "@mui/material": "^6.0.0",
    "@react-pdf/renderer": "^4.1.5",
    "i18next": "23.16.8",
    "react-i18next": "14.1.3",
    "typescript": "^5.6.3"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "29.0.2",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-image": "2.1.1",
    "@svgr/rollup": "8.1.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@testing-library/react-hooks": "8.0.1",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "eslint": "9.29.0",
    "eslint-plugin-autofix": "2.2.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.20",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-unused-imports": "4.3.0",
    "i18next": "23.16.8",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "react-i18next": "14.1.3",
    "rollup": "4.59.0",
    "rollup-plugin-dts": "6.4.1",
    "rollup-plugin-peer-deps-external": "2.2.4",
    "rollup-plugin-postcss": "4.0.2",
    "rollup-plugin-typescript2": "0.36.0",
    "typescript": "5.9.3"
  }
}
